[resource]
script = ExtResource("1_objective")
id = "corruption_reservoir"
display_name = "Corruption Reservoir"
description = "A sink of accumulated rot beneath the block. Holding it raises how much Corruption the cult can bear before the Rogue Entities wake, and it is what lets the cult draw Rites at all; if the corporations take it they pump the filth out and their units crossing it are faster and tougher."
