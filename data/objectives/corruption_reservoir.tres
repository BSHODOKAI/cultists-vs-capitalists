revealed_damage_bonus = 0.0
corruption_cap_bonus = 25
jam_duration_mult = 1.0
capture_enemy_speed_bonus = 0.15
capture_enemy_damage_reduction = 0.1
capture_banner_text = "CORPORATE SEIZURE: the Reservoir feeds their ranks (+15% speed, -10% damage taken on corporate ground)!"