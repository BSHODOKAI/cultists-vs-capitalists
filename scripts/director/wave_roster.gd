## WaveRoster
##
## Pure-logic (RefCounted) output container for a wave generated by WaveDirector.
## Holds:
##   • Wave schedule metadata (wave_number, interval_index, completed_cycles,
##     active_faction, is_mixed_interval, is_boss_wave, is_stars_are_right).
##   • Budget breakdown (full_budget, budget, escort_budget, withheld_budget,
##     rubber_factor, effective_rubber_factor, total_cost).
##   • Aggregated unit entries (entries[]) and ordered spawn schedule (spawn_schedule[]).
##   • Boss info (boss_id, boss_display_name, boss_signature_mechanic, boss_index,
##     boss_base_hp, boss_hp).
##   • Telegraph Intel payload (intel{}).
##   • Fairness & diagnostics (per_tag_exposure{}, pick_rationales[], fairness_swaps[],
##     excess_level_upgrades{}, logs[]).
class_name WaveRoster
extends RefCounted

const _C = preload("res://scripts/path/path_constants.gd")
const _CoverageTracker = preload("res://scripts/director/coverage_tracker.gd")

var wave_number: int = 1
var seed_used: int = 1
var interval_index: int = 1
var completed_cycles: int = 0
var active_faction: String = ""
var next_faction_after_boss: String = ""
var is_mixed_interval: bool = false
var is_boss_wave: bool = false
var is_stars_are_right: bool = false
## Run-Event id active for this wave ("" = none). Not advertised to the player.
var event_id: String = ""

var rubber_factor: float = 1.0
var effective_rubber_factor: float = 1.0
var full_budget: float = 0.0
var budget: float = 0.0
var escort_budget: float = 0.0
var withheld_budget: float = 0.0
var total_cost: float = 0.0
## Budget the director could not spend this wave (unit cap AND per-type bonus-level cap
## both reached). Reserved for future fork/objective budgets; never silently discarded.
var unspent_budget: float = 0.0
var wave_time_window: float = 36.0
var max_deliverable_units: int = 60

## Multi-lane fork metadata for this wave:
var lane_count: int = 1
var fork_budget: float = 0.0
## Maps fork lane_id (int >= 1) -> faction_id (String).
var fork_factions: Dictionary = {}
## Maps lane_id (int >= 0) -> regular unit count scheduled on that lane.
var lane_unit_counts: Dictionary = {0: 0}

## Array of {
##   "unit_id": String,
##   "display_name": String,
##   "faction": String,
##   "count": int,
##   "base_cost": int,
##   "base_level": int,
##   "bonus_level": int,
##   "spawn_level": int,
##   "effective_cost": float,
##   "total_cost": float,
##   "tags": Array[int],
## }
var entries: Array[Dictionary] = []

## Ordered spawn schedule following SPAWN ORDER rules:
## Array of {
##   "spawn_index": int,
##   "unit_id": String,
##   "display_name": String,
##   "is_boss": bool,
##   "is_escort": bool,
##   "spawn_time": float,
##   "spawn_level": int,
##   "role": String,
##   "tags": Array[int],
##   "effective_cost": float,
##   "boss_index": int,
##   "boss_hp": float,
## }
var spawn_schedule: Array[Dictionary] = []

var boss_id: String = ""
var boss_display_name: String = ""
var boss_signature_mechanic: String = ""
var boss_index: int = 0
var boss_base_hp: float = 0.0
var boss_hp: float = 0.0

## Pre-wave Intel payload for telegraphing UI.
var intel: Dictionary = {}

## Per-tag exposure dictionary mapping UnitTag (int and String name) -> Dictionary:
## { "unit_count": int, "budget_spent": float, "budget_share": float, "coverage_dps": float }
var per_tag_exposure: Dictionary = {}

## Per-pick rationale log:
## Array of {
##   "pick_index": int,
##   "unit_id": String,
##   "score": float,
##   "dominant_reason": String,
##   "weakness_exploit": float,
##   "diversity": float,
##   "faction_weight": float,
##   "counter_bias": float,
##   "noise": float,
##   "effective_cost": float,
## }
var pick_rationales: Array[Dictionary] = []

## Fairness swaps performed after roster generation:
## Array of { "removed_unit_id": String, "added_unit_id": String, "reason": String }
var fairness_swaps: Array[Dictionary] = []

## Excess budget spent as +1 level on chosen unit types when MAX_UNITS_PER_WAVE is reached:
## unit_id (String) -> bonus_levels (int).
var excess_level_upgrades: Dictionary = {}

## Human-readable director diagnostic log lines for this wave.
var logs: Array[String] = []


## Total number of regular (non-boss) units in the wave.
func get_total_regular_unit_count() -> int:
	var total: int = 0
	for e: Dictionary in entries:
		total += int(e.get("count", 0))
	return total


## Number of distinct regular unit types in the wave.
func get_distinct_unit_type_count() -> int:
	var count: int = 0
	for e: Dictionary in entries:
		if int(e.get("count", 0)) > 0:
			count += 1
	return count


## Returns all distinct regular unit IDs in the roster.
func get_distinct_unit_ids() -> Array[String]:
	var ids: Array[String] = []
	for e: Dictionary in entries:
		if int(e.get("count", 0)) > 0:
			ids.append(String(e["unit_id"]))
	return ids


## Returns the count of [param unit_id] in the roster.
func get_unit_count(unit_id: String) -> int:
	for e: Dictionary in entries:
		if String(e.get("unit_id", "")) == unit_id:
			return int(e.get("count", 0))
	return 0


## Returns total budget spent on [param unit_id].
func get_unit_budget_spent(unit_id: String) -> float:
	for e: Dictionary in entries:
		if String(e.get("unit_id", "")) == unit_id:
			return float(e.get("total_cost", 0.0))
	return 0.0


## Returns total budget spent on units having [param unit_tag].
func get_tag_budget_spent(unit_tag: int) -> float:
	var sum_cost: float = 0.0
	for e: Dictionary in entries:
		var tags: Array = e.get("tags", [])
		if tags.has(unit_tag):
			sum_cost += float(e.get("total_cost", 0.0))
	return sum_cost


## Returns total count of units having [param unit_tag].
func get_tag_unit_count(unit_tag: int) -> int:
	var sum_count: int = 0
	for e: Dictionary in entries:
		var tags: Array = e.get("tags", [])
		if tags.has(unit_tag):
			sum_count += int(e.get("count", 0))
	return sum_count


func get_air_budget_spent() -> float:
	return get_tag_budget_spent(_C.UnitTag.AIR)


func get_spawner_count() -> int:
	return get_tag_unit_count(_C.UnitTag.SPAWNER)


func get_healer_count() -> int:
	return get_tag_unit_count(_C.UnitTag.HEALER)


func to_dict() -> Dictionary:
	return {
		"wave_number": wave_number,
		"seed_used": seed_used,
		"interval_index": interval_index,
		"completed_cycles": completed_cycles,
		"active_faction": active_faction,
		"next_faction_after_boss": next_faction_after_boss,
		"is_mixed_interval": is_mixed_interval,
		"is_boss_wave": is_boss_wave,
		"is_stars_are_right": is_stars_are_right,
		"event_id": event_id,
		"rubber_factor": rubber_factor,
		"effective_rubber_factor": effective_rubber_factor,
		"full_budget": full_budget,
		"budget": budget,
		"escort_budget": escort_budget,
		"withheld_budget": withheld_budget,
		"total_cost": total_cost,
		"unspent_budget": unspent_budget,
		"wave_time_window": wave_time_window,
		"max_deliverable_units": max_deliverable_units,
		"entries": entries.duplicate(true),
		"spawn_schedule": spawn_schedule.duplicate(true),
		"boss_id": boss_id,
		"boss_display_name": boss_display_name,
		"boss_signature_mechanic": boss_signature_mechanic,
		"boss_index": boss_index,
		"boss_base_hp": boss_base_hp,
		"boss_hp": boss_hp,
		"intel": intel.duplicate(true),
		"per_tag_exposure": per_tag_exposure.duplicate(true),
		"pick_rationales": pick_rationales.duplicate(true),
		"fairness_swaps": fairness_swaps.duplicate(true),
		"excess_level_upgrades": excess_level_upgrades.duplicate(true),
		"logs": logs.duplicate(),
	}
